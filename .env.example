# M0 does not connect to authenticated services.
# Never commit real credentials. Use the server's environment or secret manager.
ATA_ENV=development
ATA_LOG_LEVEL=INFO

# M4 research model is opt-in; do not put real tokens in this file.
ATA_SHADOW_ENABLE_LLM=0
# ATA_LLM_BASE_URL=https://provider.example/v1
# ATA_LLM_MODEL=model-id
# ATA_LLM_API_KEY=DO_NOT_COMMIT_A_REAL_SECRET
# ATA_SHADOW_DB_PATH=data/shadow.sqlite3
